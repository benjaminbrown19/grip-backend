# Copiar este archivo como .env (en EC2 o en tu PC) y reemplazar los valores.
# NUNCA subir .env a GitHub (ya esta en .gitignore).
# Usar solo letras y numeros en las claves para evitar problemas de escape.

# Puerto publico de la API.
BACKEND_PORT=8080

# Base de datos.
GRIP_DB_NAME=grip_sneaker_store
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT
GRIP_DB_PASSWORD=CAMBIAR_CLAVE_APP

# Clave para firmar los JWT: 32 caracteres o mas, aleatoria y nueva.
# No reutilizar ninguna clave que aparezca en README o documentos.
GRIP_JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_32_O_MAS

# Cuentas iniciales (ana.perez@duoc.cl y carlos.soto@duoc.cl).
# Minimo 8 caracteres (lo exigen el backend y el login del frontend).
GRIP_ADMIN_PASSWORD=CAMBIAR8
GRIP_VENDEDOR_PASSWORD=CAMBIAR8
